# ==========================================
# GitHub Configuration
# ==========================================
# Personal Access Token (for local testing) or auto-provided GITHUB_TOKEN in CI
GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_REPOSITORY=owner/repository_name
PR_NUMBER=1

# ==========================================
# Telegram Bot Configuration
# ==========================================
# Token obtained from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# Your personal chat_id or group chat_id (e.g., from @userinfobot)
TELEGRAM_CHAT_ID=123456789

# ==========================================
# LLM Provider Configuration
# ==========================================
# Supported providers: gemini (default), deepseek, groq, openai, custom
LLM_PROVIDER=gemini
# API Key (Google AI Studio / DeepSeek / Groq / OpenAI)
LLM_API_KEY=AIzaSyYourGeminiApiKeyHere

# Optional: Override default model
# Gemini defaults: gemini-2.5-flash / gemini-2.0-flash
# DeepSeek defaults: deepseek-chat / deepseek-reasoner
# Groq defaults: llama-3.3-70b-versatile
# OpenAI defaults: gpt-4o-mini / o3-mini
LLM_MODEL=

# Optional: Base URL for custom or local endpoints (e.g., Ollama: http://localhost:11434/v1)
LLM_BASE_URL=

# ==========================================
# Review Tuning
# ==========================================
# Max lines of diff to process before truncating
MAX_DIFF_LINES=1500
